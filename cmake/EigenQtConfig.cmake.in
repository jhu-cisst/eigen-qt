# SPDX-License-Identifier: MIT
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.4 NO_MODULE)
set(EigenQt_QT_VERSION "@EIGENQT_QT_VERSION@")
find_dependency(Qt@EIGENQT_QT_VERSION@ COMPONENTS Widgets)
find_dependency(OpenGL)
if(@EIGENQT_QT_VERSION@ EQUAL 6)
  find_dependency(Qt6 COMPONENTS OpenGLWidgets)
else()
  find_dependency(Qt5 COMPONENTS OpenGL)
endif()
include(${CMAKE_CURRENT_LIST_DIR}/EigenQtWidgetsTargets.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/EigenQtPlotTargets.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/EigenQtGeometryTargets.cmake)
set(EigenQt_Widgets_FOUND TRUE)
set(EigenQt_Plot_FOUND TRUE)
set(EigenQt_Geometry_FOUND TRUE)
check_required_components(EigenQt)
